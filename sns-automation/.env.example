# Claude API (未設定でも `ant auth login` 済みならそのプロファイルが使われます)
ANTHROPIC_API_KEY=

# X (Twitter) API v2 — OAuth 1.0a ユーザーコンテキスト（書き込み権限付きアプリ）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Graph API — ビジネス/クリエイターアカウント + Facebookページ連携が必要
IG_USER_ID=
IG_ACCESS_TOKEN=

# LINE公式アカウント（Messaging API）— 友だち数の取得
LINE_CHANNEL_ACCESS_TOKEN=

# タイムゾーン（投稿日時の集計に使用）
SNS_TZ=Asia/Tokyo
